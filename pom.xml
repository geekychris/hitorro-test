<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.hitorro</groupId>
    <artifactId>hitorro-test</artifactId>
    <version>3.0.1</version>
    <packaging>jar</packaging>

    <name>Hitorro Unit Tests</name>
    <description>Comprehensive unit tests for the Hitorro project modules</description>
    <url>https://github.com/yourusername/hitorro-test</url>

    <properties>
        <hitorro.deploy.repo.path>${user.home}/code/hitorro-maven</hitorro.deploy.repo.path>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <maven.compiler.release>19</maven.compiler.release>
        
        <!-- Dependency Versions -->
        <junit.version>4.13.2</junit.version>
        <trove4j.version>3.0.3</trove4j.version>
    </properties>

    <dependencies>
        <!-- JUnit for testing -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>${junit.version}</version>
            <scope>compile</scope> <!-- Note: compile scope since this module IS the tests -->
        </dependency>

        <!-- Trove4j - High-performance collections -->
        <dependency>
            <groupId>net.sf.trove4j</groupId>
            <artifactId>trove4j</artifactId>
            <version>${trove4j.version}</version>
        </dependency>

        <!-- 
        ========================================================================
        INTERNAL HITORRO MODULE DEPENDENCIES
        ========================================================================
        
        This test module originally depended on ALL Hitorro modules to test them.
        These dependencies are commented out to allow standalone project creation.
        
        To run the tests, you need to either:
        1. Install all required Hitorro modules to your local Maven repository
        2. Uncomment the dependencies below
        3. Run: mvn clean test
        
        Required modules:
        - hitorro-features (feature extraction)
        - hitorro-basedms (base DMS/persistence)
        - hitorro-jsonsql (JSON SQL queries)
        - hitorro-logdigest (log processing)
        - hitorro-analysis (NLP analysis)
        - hitorro-conversation (conversation tracking)
        - hitorro-text-core (text processing)
        - hitorro-text-persistence (text storage)
        ========================================================================
        -->
        

        <dependency>
            <groupId>com.hitorro</groupId>
            <artifactId>hitorro-features</artifactId>
            <version>3.0.1</version>
        </dependency>
        <dependency>
            <groupId>com.hitorro</groupId>
            <artifactId>hitorro-basedms</artifactId>
            <version>3.0.1</version>
        </dependency>
        <dependency>
            <groupId>com.hitorro</groupId>
            <artifactId>hitorro-jsonsql</artifactId>
            <version>3.0.1</version>
        </dependency>
        <dependency>
            <groupId>com.hitorro</groupId>
            <artifactId>hitorro-logdigest</artifactId>
            <version>3.0.1</version>
        </dependency>
        <dependency>
            <groupId>com.hitorro</groupId>
            <artifactId>hitorro-analysis</artifactId>
            <version>3.0.1</version>
        </dependency>
        <dependency>
            <groupId>com.hitorro</groupId>
            <artifactId>hitorro-conversation</artifactId>
            <version>3.0.1</version>
        </dependency>
        <dependency>
            <groupId>com.hitorro</groupId>
            <artifactId>hitorro-text-core</artifactId>
            <version>3.0.1</version>
        </dependency>
        <dependency>
            <groupId>com.hitorro</groupId>
            <artifactId>hitorro-text-persistence</artifactId>
            <version>3.0.1</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Compiler Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                    <release>21</release>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

            <!-- Surefire Plugin for running tests -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.0.0-M9</version>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/Test*.java</include>
                    </includes>
                    <!-- Skip tests by default since dependencies are commented out -->
                    <skipTests>true</skipTests>
                </configuration>
            </plugin>

            <!-- JAR Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                            <addDefaultSpecificationEntries>true</addDefaultSpecificationEntries>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <!-- Source Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.0</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Javadoc Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.6.3</version>
                <configuration>
                    <doclint>none</doclint>
                    <quiet>true</quiet>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <distributionManagement>
        <repository>
            <id>hitorro-local</id>
            <name>Hitorro Local Maven Repository</name>
            <url>file://${hitorro.deploy.repo.path}</url>
        </repository>
        <snapshotRepository>
            <id>hitorro-local-snapshots</id>
            <name>Hitorro Local Maven Snapshot Repository</name>
            <url>file://${hitorro.deploy.repo.path}</url>
        </snapshotRepository>
    </distributionManagement>

</project>
